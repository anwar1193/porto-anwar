# Turso database. For local development you can use a file database instead:
# TURSO_DATABASE_URL="file:local.db"
TURSO_DATABASE_URL="libsql://porto-anwar-<organization>.turso.io"
TURSO_AUTH_TOKEN="<token-from-turso>"

# Vercel Blob, untuk upload gambar di CMS.
# Buat store di dashboard Vercel lalu jalankan `vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN="<token-from-vercel-blob>"

# Only needed by `npm run db:seed`. Do not set these in the Vercel runtime.
ADMIN_EMAIL="admin@anwar.dev"
ADMIN_NAME="Anwar"
ADMIN_PASSWORD="replace-with-a-strong-password"
